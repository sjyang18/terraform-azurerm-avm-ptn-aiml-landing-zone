{
  "image": "mcr.microsoft.com/azterraform:avm-latest",
  "updateRemoteUserUID": true,
  "runArgs": ["--privileged"],
  "mounts": [],
  "onCreateCommand": "apk add --no-cache docker docker-cli docker-compose && rc-update add docker boot && service docker start || terraform || true",
  "customizations": {
    "vscode": {
      "settings": {
        "terraform.languageServer.terraform.path": "/home/runtimeuser/tfenv/bin/terraform"
      },
      "extensions": [
        "ms-azuretools.vscode-azureterraform",
        "EditorConfig.EditorConfig",
        "hashicorp.terraform"
      ]
    }
  }
}
